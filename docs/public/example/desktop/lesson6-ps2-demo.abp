  "blockPacks": [
    {
      "format": "mbc-block-pack",
      "target": "arduino:avr",
      "specVersion": 1,
      "nested": true,
      "id": "mbc_jbot",
      "version": 1,
      "name": "MBC-jBot 核心套件",
      "colour": "#4C97FF",
      "author": "MBC Robot Team",
      "description": "專為雙輪差速 MBC-jBot 機器人設計，提供完整硬體驅動：雙輪 PID 距離與角度控制、光學編碼器、雙路紅外循線感測、VL53L0X 雷射測距、4 顆 WS2812 彩燈、SSD1315 OLED 螢幕（選購，英文與數字）、雙路伺服馬達、PS2 無線手把遙控、電池電壓與開機按鈕。",
      "categories": [
        {
          "name": "jBot 運動",
          "colour": "#4C97FF"
        },
        {
          "name": "jBot 感測",
          "colour": "#5CB1D6"
        },
        {
          "name": "jBot 彩燈",
          "colour": "#9966FF"
        },
        {
          "name": "jBot 螢幕",
          "colour": "#774DCB"
        },
        {
          "name": "jBot 舵機",
          "colour": "#3373CC"
        },
        {
          "name": "jBot 遙控",
          "colour": "#2E8EB8"
        }
      ],
      "blocks": [
        {
          "id": "jbot_init",
          "specVersion": 1,
          "blockVersion": 1,
          "category": "jBot 運動",
          "colour": "#4C97FF",
          "shape": "statement",
          "message": "初始化 jBot 機器人 (等待按鈕啟動)",
          "args": [],
          "tooltip": "初始化 jBot 機器人所有周邊（馬達、伺服、編碼器、I2C 雷射、RGB 彩燈與感測器），並等待板載按鈕按下後正式啟動",
          "code": {
            "template": "Bot.begin();",
            "requires": {
              "includes": [
                "#include <JBC_Bot.h>"
              ]
            }
          }
        },
        {
          "id": "jbot_motor_run",
          "specVersion": 1,
          "blockVersion": 1,
          "category": "jBot 運動",
          "colour": "#4C97FF",
          "shape": "statement",
          "message": "馬達 %1 跑速度 %2",
          "args": [
            {
              "name": "type",
              "kind": "field_dropdown",
              "options": [
                [
                  "右",
                  "MOTOR_R"
                ],
                [
                  "左",
                  "MOTOR_L"
                ]
              ]
            },
            {
              "name": "speed",
              "kind": "input_value",
              "check": "Number",
              "shadow": {
                "block": "math_number",
                "value": 75
              }
            }
          ],
          "tooltip": "設定單側馬達運轉動力（範圍 -100 ~ 100）",
          "code": {
            "template": "Bot.setMotor({type}, {speed});",
            "requires": {
              "includes": [
                "#include <JBC_Bot.h>"
              ]
            }
          }
        },
        {
