  "blockPacks": [
    {
      "format": "mbc-block-pack",
      "target": "arduino:avr",
      "specVersion": 1,
      "nested": true,
      "id": "mbc_jbot",
      "version": 1,
      "name": "MBC-jBot 核心套件",
      "colour": "#4C97FF",
      "author": "MBC Robot Team",
      "description": "專為雙輪差速 MBC-jBot 機器人設計，提供完整硬體驅動：雙輪 PID 距離與角度控制、霍爾編碼器、雙路紅外循線感測、4 顆 RGB 彩燈（SK6812，相容 WS2812）、PS2 無線手把遙控、電池電壓與開機按鈕；選購模組：VL53L0X 雷射測距、SSD1315 OLED 螢幕（英文與數字）、雙路伺服馬達（接 I2C 擴充插槽／伺服接頭，不含在基本套件）。",
      "categories": [
        {
          "name": "jBot 運動",
          "colour": "#4C97FF"
        },
        {
          "name": "jBot 感測",
          "colour": "#5CB1D6"
        },
        {
          "name": "jBot 彩燈",
          "colour": "#9966FF"
        },
        {
          "name": "jBot 螢幕",
          "colour": "#774DCB"
        },
        {
          "name": "jBot 舵機",
          "colour": "#3373CC"
        },
        {
          "name": "jBot 遙控",
          "colour": "#2E8EB8"
        }
      ],
      "blocks": [
        {
          "id": "jbot_init",
          "specVersion": 1,
          "blockVersion": 1,
          "category": "jBot 運動",
          "colour": "#4C97FF",
          "shape": "statement",
          "message": "初始化 jBot 機器人 (等待按鈕啟動)",
          "args": [],
          "tooltip": "初始化 jBot 機器人所有周邊（馬達、伺服、編碼器、I2C 雷射、RGB 彩燈與感測器），並等待板載按鈕按下後正式啟動",
          "code": {
            "template": "Bot.begin();",
            "requires": {
              "includes": [
                "#include <JBC_Bot.h>"
              ]
            }
          }
        },
        {
          "id": "jbot_motor_run2",
          "specVersion": 1,
          "blockVersion": 1,
          "category": "jBot 運動",
          "colour": "#4C97FF",
          "shape": "statement",
          "message": "馬達跑左 %1 右 %2",
          "args": [
            {
              "name": "speedL",
              "kind": "input_value",
              "check": "Number",
              "shadow": {
                "block": "math_number",
                "value": 75
              }
            },
            {
              "name": "speedR",
              "kind": "input_value",
              "check": "Number",
              "shadow": {
                "block": "math_number",
                "value": 75
              }
            }
          ],
          "tooltip": "同時設定左右兩輪馬達運轉動力（範圍 -100 ~ 100）",
          "code": {
            "template": "Bot.setMotors({speedL}, {speedR});",
            "requires": {
              "includes": [
                "#include <JBC_Bot.h>"
              ]
            }
          }
        },
        {
          "id": "jbot_motor_stop",
          "specVersion": 1,
          "blockVersion": 1,
          "category": "jBot 運動",
          "colour": "#4C97FF",
          "shape": "statement",
          "message": "馬達 %1 剎車 %2",
          "args": [
            {
              "name": "type",
              "kind": "field_dropdown",
              "options": [
                [
                  "右",
                  "MOTOR_R"
                ],
                [
                  "左",
                  "MOTOR_L"
                ]
              ]
            },
            {
              "name": "mode",
              "kind": "field_dropdown",
              "options": [
                [
                  "滑行",
                  "0"
                ],
                [
                  "煞停",
                  "BRAKE"
                ]
              ]
            }
          ],
          "tooltip": "停止指定馬達（滑行模式輸出 0 動力；煞停模式產生主動短路電子剎車）",
          "code": {
            "template": "Bot.setMotor({type}, {mode});",
            "requires": {
              "includes": [
                "#include <JBC_Bot.h>"
              ]
            }
          }
        },
        {
          "id": "jbot_laser_distance",
          "specVersion": 1,
          "blockVersion": 1,
          "category": "jBot 感測",
          "colour": "#5CB1D6",
          "shape": "value",
          "output": "Number",
          "message": "VL53L0 雷射距離數值",
          "args": [],
          "tooltip": "讀取 VL53L0X 飛行時間 (ToF) 雷射測距感應器距離數值 (單位：公厘 mm)",
          "code": {
            "template": "Bot.getDistance()",
            "requires": {
