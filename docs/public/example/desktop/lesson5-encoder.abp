            {
              "name": "mode",
              "kind": "field_dropdown",
              "options": [
                [
                  "滑行",
                  "0"
                ],
                [
                  "煞停",
                  "BRAKE"
                ]
              ]
            }
          ],
          "tooltip": "停止指定馬達（滑行模式輸出 0 動力；煞停模式產生主動短路電子剎車）",
          "code": {
            "template": "Bot.setMotor({type}, {mode});",
            "requires": {
              "includes": [
                "#include <JBC_Bot.h>"
              ]
            }
          }
        },
