  "blockPacks": [
    {
      "format": "mbc-block-pack",
      "target": "arduino:avr",
      "specVersion": 1,
      "nested": true,
      "id": "mbc_jbot",
      "version": 1,
      "name": "MBC-jBot 核心套件",
      "colour": "#4C97FF",
      "author": "MBC Robot Team",
      "description": "專為雙輪差速 MBC-jBot 機器人設計，提供完整硬體驅動：雙輪 PID 距離與角度控制、霍爾編碼器、雙路紅外循線感測、4 顆 RGB 彩燈（SK6812，相容 WS2812）、PS2 無線手把遙控、電池電壓與開機按鈕；選購模組：VL53L0X 雷射測距、0.49 吋 SSD1315 OLED 螢幕（英文與數字）、雙路伺服馬達（接 I2C 擴充插槽／伺服接頭，不含在基本套件）。",
      "categories": [
        {
          "name": "jBot 運動",
          "colour": "#4C97FF"
        },
        {
          "name": "jBot 感測",
          "colour": "#5CB1D6"
        },
        {
          "name": "jBot 彩燈",
          "colour": "#9966FF"
        },
        {
          "name": "jBot 螢幕",
          "colour": "#774DCB"
        },
        {
          "name": "jBot 舵機",
          "colour": "#3373CC"
        },
        {
          "name": "jBot 遙控",
          "colour": "#2E8EB8"
        }
      ],
      "blocks": [
        {
          "id": "jbot_init",
          "specVersion": 1,
          "blockVersion": 1,
          "category": "jBot 運動",
          "colour": "#4C97FF",
          "shape": "statement",
          "message": "初始化 jBot 機器人 (等待按鈕啟動)",
          "args": [],
          "tooltip": "初始化 jBot 機器人所有周邊（馬達、伺服、編碼器、I2C 雷射、RGB 彩燈與感測器），並等待板載按鈕按下後正式啟動",
          "code": {
            "template": "Bot.begin();",
            "requires": {
              "includes": [
                "#include <JBC_Bot.h>"
              ]
            }
          }
        },
        {
          "id": "jbot_led_set",
          "specVersion": 1,
          "blockVersion": 1,
          "category": "jBot 彩燈",
          "colour": "#9966FF",
          "shape": "statement",
          "message": "設定第 %1 顆 LED 顏色 紅 %2 綠 %3 藍 %4",
          "args": [
            {
              "name": "index",
              "kind": "field_dropdown",
              "options": [
                [
                  "1",
                  "1"
                ],
                [
                  "2",
                  "2"
                ],
                [
                  "3",
                  "3"
                ],
                [
                  "4",
                  "4"
                ]
              ]
            },
            {
              "name": "r",
              "kind": "input_value",
              "check": "Number",
              "shadow": {
                "block": "math_number",
                "value": 255
              }
            },
            {
              "name": "g",
              "kind": "input_value",
              "check": "Number",
              "shadow": {
                "block": "math_number",
                "value": 0
              }
            },
            {
              "name": "b",
              "kind": "input_value",
              "check": "Number",
              "shadow": {
                "block": "math_number",
                "value": 0
              }
            }
          ],
          "tooltip": "設定指定編號板載 WS2812/SK6812 全彩 RGB LED 的紅、綠、藍色彩強度 (0 ~ 255)",
          "code": {
            "template": "Bot.setLED({index} - 1, {r}, {g}, {b});",
            "requires": {
              "includes": [
                "#include <JBC_Bot.h>"
              ]
            }
          }
        },
        {
          "id": "jbot_oled_clear",
          "specVersion": 1,
          "blockVersion": 1,
          "category": "jBot 螢幕",
          "colour": "#774DCB",
          "shape": "statement",
          "message": "清空 OLED 螢幕",
          "args": [],
          "tooltip": "清除 OLED 螢幕上所有文字（擴充包的 0.49 吋 SSD1315 OLED，接在 OLED 插座）",
          "code": {
            "template": "Bot.oled_clear();",
            "requires": {
              "includes": [
                "#include <JBC_Bot.h>"
