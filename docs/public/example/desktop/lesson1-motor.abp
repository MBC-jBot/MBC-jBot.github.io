        },
        {
          "name": "jBot 螢幕",
          "colour": "#00A0A0"
        },
        {
          "name": "jBot 舵機",
          "colour": "#E8A325"
        },
        {
          "name": "jBot 遙控",
          "colour": "#2E7D32"
        }
      ],
      "blocks": [
        {
          "id": "jbot_init",
          "specVersion": 1,
          "blockVersion": 1,
          "category": "jBot 運動",
          "colour": "#4E92F2",
          "shape": "statement",
          "message": "初始化 jBot 機器人 (等待按鈕啟動)",
          "args": [],
          "tooltip": "初始化 jBot 機器人所有周邊（馬達、伺服、編碼器、I2C 雷射、RGB 彩燈與感測器），並等待板載按鈕按下後正式啟動",
          "code": {
            "template": "Bot.begin();",
            "requires": {
              "includes": [
                "#include <JBC_Bot.h>"
              ]
            }
          }
        },
        {
          "id": "jbot_motor_run2",
          "specVersion": 1,
          "blockVersion": 1,
          "category": "jBot 運動",
          "colour": "#4E92F2",
          "shape": "statement",
          "message": "馬達跑左 %1 右 %2",
          "args": [
            {
              "name": "speedL",
              "kind": "input_value",
              "check": "Number",
              "shadow": {
                "block": "math_number",
                "value": 75
              }
            },
            {
              "name": "speedR",
              "kind": "input_value",
              "check": "Number",
              "shadow": {
                "block": "math_number",
                "value": 75
              }
            }
          ],
          "tooltip": "同時設定左右兩輪馬達運轉動力（範圍 -100 ~ 100）",
          "code": {
            "template": "Bot.setMotors({speedL}, {speedR});",
            "requires": {
              "includes": [
                "#include <JBC_Bot.h>"
              ]
            }
          }
        },
        {
          "id": "jbot_motor_stop",
          "specVersion": 1,
          "blockVersion": 1,
          "category": "jBot 運動",
          "colour": "#4E92F2",
          "shape": "statement",
          "message": "馬達 %1 剎車 %2",
          "args": [
            {
              "name": "type",
